{
  "name": "kittex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typesets the LaTeX math in terminal replies as real TeX images (kitty graphics protocol), with a Claude Code mod",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "build": "node scripts/build.mjs",
    "check:sandbox": "node scripts/sandbox-check.mjs",
    "stress": "KITTEX_STRESS=1 vitest run core/test/stress"
  },
  "devDependencies": {
    "@mathjax/mathjax-newcm-font": "^4.1.3",
    "@mathjax/src": "^4.1.3",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
