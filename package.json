{
  "name": "kittex",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Typesets the LaTeX math in terminal replies as real TeX images (kitty graphics protocol), with a Claude Code mod",
  "scripts": {
    "test": "vitest run",
    "fuzz": "sh scripts/fuzz.sh",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "build": "node scripts/build.mjs",
    "check:sandbox": "node scripts/sandbox-check.mjs",
    "stress": "KITTEX_STRESS=1 vitest run core/test/stress",
    "readme:banner": "node .github/scripts/banner/build.mjs",
    "readme:banner:preview": "node .github/scripts/banner/build.mjs && node .github/scripts/banner/preview.mjs",
    "readme:demo": "node .github/scripts/demo/render.mjs",
    "readme:demo:record": "python3 .github/scripts/demo/record.py",
    "readme:social": "node .github/scripts/social/build.mjs"
  },
  "devDependencies": {
    "@mathjax/mathjax-newcm-font": "^4.1.3",
    "@mathjax/src": "^4.1.3",
    "@types/node": "^26.6.4",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/headless": "^6.0.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "marked": "15.0.6",
    "opentype.js": "^2.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
